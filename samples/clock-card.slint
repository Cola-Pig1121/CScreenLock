// ScreenLock 自定义控件示例 —— 极简时钟卡片
//
// 用法：把本文件复制到 ScreenLock 配置目录下的 custom-widgets/ 文件夹：
//   Windows:  %APPDATA%\ScreenLock\custom-widgets\
//   macOS:    ~/Library/Application Support/ScreenLock/custom-widgets/
//   Linux:    ~/.config/ScreenLock/custom-widgets/
// 下次锁屏时自动生效。
//
// 约定（必须声明，宿主经这些属性控制窗口；interpreter 无法设置 Window 内建属性）：
//   - win-title：宿主注入统一标题（置顶识别用）
//   - win-w / win-h：窗口逻辑尺寸
//   - x-ratio / y-ratio：0~1，控件在屏幕上的位置比例
//   - time / date：宿主每秒注入的当前时间（HH:MM）与日期

export component Widget inherits Window {
    in property <string> win-title;
    title: win-title;
    in property <float> win-w: 220;
    in property <float> win-h: 110;
    preferred-width: win-w * 1px;
    preferred-height: win-h * 1px;

    in property <float> x-ratio: 0.85;
    in property <float> y-ratio: 0.06;
    in property <string> time;
    in property <string> date;

    no-frame: true;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        background: #FFFFFFE0;
        border-width: 1px;
        border-color: #CAC4D0;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.time;
                font-size: 40px;
                font-weight: 300;
                color: #1C1B1F;
                horizontal-alignment: center;
            }
            Text {
                text: root.date;
                font-size: 14px;
                color: #79747E;
                horizontal-alignment: center;
            }
        }
    }
}
