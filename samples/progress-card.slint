// ScreenLock 自定义控件示例 —— 倒计时/进度条卡片
//
// 复制到配置目录 custom-widgets/ 即生效。
// 约定同 clock-card.slint：win-title / win-w / win-h / x-ratio / y-ratio / time / date。

export component Widget inherits Window {
    in property <string> win-title;
    title: win-title;
    in property <float> win-w: 260;
    in property <float> win-h: 120;
    preferred-width: win-w * 1px;
    preferred-height: win-h * 1px;

    in property <float> x-ratio: 0.06;
    in property <float> y-ratio: 0.78;
    in property <string> time;
    in property <string> date;

    property <int> target-days: 100;

    no-frame: true;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        background: #FFFFFFE0;
        border-width: 1px;
        border-color: #CAC4D0;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            alignment: center;
            Text {
                text: "距离目标还有 " + (root.target-days) + " 天";
                font-size: 15px;
                font-weight: 600;
                color: #1C1B1F;
            }
            Rectangle {
                height: 8px;
                border-radius: 4px;
                background: #E0E0E0;
                Rectangle {
                    width: parent.width * 0.62;
                    height: 100%;
                    border-radius: 4px;
                    background: #4355B9;
                }
            }
            Text {
                text: "进度 62% · " + root.time;
                font-size: 12px;
                color: #79747E;
            }
        }
    }
}
